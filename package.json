{
  "name": "costa-calma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_PROD=1 playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:e2e && npm run test:e2e:prod",
    "prepare": "husky",
    "screenshots": "CAPTURE_SCREENSHOTS=1 E2E_PROD=1 playwright test e2e/visual-review.spec.ts e2e/house-model.spec.ts e2e/house-models.spec.ts",
    "test": "vitest run",
    "media:flight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/media/build-sequence.mts flight",
    "media:houses": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/media/build-house-placeholders.mts",
    "media:furniture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/media/build-furniture.mts",
    "media:furniture:upload": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/media/upload-furniture.mts",
    "site:draw": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/site/draw-site.mts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "maath": "^0.10.8",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postprocessing": "^6.39.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vercel/blob": "^2.8.2",
    "babel-plugin-react-compiler": "1.0.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
